# Copy to `.env` and fill in. `.env` is gitignored.

# --- Database ---
# Local dev: SQLite (zero setup).
DATABASE_URL="file:./dev.db"
# Production (Neon Postgres): switch prisma/schema.prisma provider to
# "postgresql", add directUrl, then set:
#   DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
#   DIRECT_URL="postgresql://.../neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Single-user seed (scripts/seed.ts creates this login).
SEED_EMAIL=""
SEED_PASSWORD=""
SEED_NAME=""

# --- Anthropic (agent chat, Phase 3) ---
ANTHROPIC_API_KEY=""

# --- Yahoo Fantasy (Phase 1) — READ-ONLY, advise-only ---
# Register an app at https://developer.yahoo.com/apps/ (Fantasy Sports: Read).
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
# Redirect URI to register: http://localhost:3000/api/yahoo/callback
YAHOO_REDIRECT_URI="http://localhost:3000/api/yahoo/callback"

# --- Reddit (Phase 4) — free "script" app ---
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# --- The Odds API (Phase 5, player props) ---
ODDS_API_KEY=""

# --- Cron auth ---
# Any long random string. Cron endpoints require `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
